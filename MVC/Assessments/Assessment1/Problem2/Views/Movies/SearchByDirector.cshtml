<h2>Search Movies By Director</h2>

@using (Html.BeginForm())
{
    <div class="form-group">
        <label>Director Name</label>

        <input type="text"
               name="directorName"
               class="form-control" />
    </div>

    <br />

    <input type="submit"
           value="Search"
           class="btn btn-primary" />
}