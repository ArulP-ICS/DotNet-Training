<h2>Search Movies By Year</h2>

@using (Html.BeginForm())
{
    <div class="form-group">
        <label>Enter Year</label>

        <input type="number"
               name="year"
               class="form-control" />
    </div>

    <br />

    <input type="submit"
           value="Search"
           class="btn btn-primary" />
}