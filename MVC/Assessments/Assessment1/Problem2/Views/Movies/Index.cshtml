@model IEnumerable<Problem2.Models.Movie>

@{
    ViewBag.Title = "Movies List";
}

<h2>Movies List</h2>

<p>
    @Html.ActionLink("Add Movie", "Create", null,
    new { @class = "btn btn-primary" })

    @Html.ActionLink("Search By Year", "SearchByYear", null,
    new { @class = "btn btn-secondary" })

    @Html.ActionLink("Search By Director", "SearchByDirector", null,
    new { @class = "btn btn-secondary" })
</p>

<table class="table table-bordered">
    <tr>
        <th>ID</th>
        <th>Movie Name</th>
        <th>Director Name</th>
        <th>Date Of Release</th>
        <th>Action</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Mid</td>
            <td>@item.MovieName</td>
            <td>@item.DirectorName</td>
            <td>@item.DateOfRelease.ToShortDateString()</td>

            <td>
                @Html.ActionLink("Edit", "Edit",
                    new { id = item.Mid })

                |

                @Html.ActionLink("Delete", "Delete",
                    new { id = item.Mid })
            </td>
        </tr>
    }
</table>