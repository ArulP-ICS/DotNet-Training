@model Problem1.Models.Customer

@{
    ViewBag.Title = "Customer Details";
}

<h2 style="color:blue;">Customer Details For Order ID = 10248</h2>

<table border="1" cellpadding="8" cellspacing="0" width="60%">
    <tr style="background-color:lightgray;">
        <th>Field</th>
        <th>Value</th>
    </tr>

    <tr>
        <td>Customer ID</td>
        <td>@Model.CustomerID</td>
    </tr>

    <tr>
        <td>Company Name</td>
        <td>@Model.CompanyName</td>
    </tr>

    <tr>
        <td>Contact Name</td>
        <td>@Model.ContactName</td>
    </tr>

    <tr>
        <td>Address</td>
        <td>@Model.Address</td>
    </tr>

    <tr>
        <td>City</td>
        <td>@Model.City</td>
    </tr>

    <tr>
        <td>Country</td>
        <td>@Model.Country</td>
    </tr>

    <tr>
        <td>Phone</td>
        <td>@Model.Phone</td>
    </tr>
</table>